<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1234567-AAAA-BBBB-CCCC-DDDDDDDDDDDD}</ProjectGuid>
    <RootNamespace>DDCBrightness</RootNamespace>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <ProjectVersion>1.0</ProjectVersion>
    <!-- 使用最新的 Windows SDK 版本 -->
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
    <!-- WDK 路径 (可通过环境变量覆盖) -->
    <WDKContentRoot Condition="'$(WDKContentRoot)' == ''">C:\Program Files (x86)\Windows Kits\10\</WDKContentRoot>
    <!-- WDK km 头文件版本 (可能与 Windows SDK 版本不同) -->
    <WDKVersion Condition="'$(WDKVersion)' == ''">$(WindowsTargetPlatformVersion)</WDKVersion>
    <KmdfVersionMajor>1</KmdfVersionMajor>
    <KmdfVersionMinor>33</KmdfVersionMinor>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- Debug x64 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>

  <!-- Release x64 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- 输出配置: 生成 .sys 文件 -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(ProjectDir)..\build\intermediate\$(ProjectName)\$(Configuration)\$(Platform)\</IntDir>
    <TargetName>DDCBrightness</TargetName>
    <TargetExt>.sys</TargetExt>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <!-- 内核模式编译设置 (替代 WindowsKernelModeDriver10.0 工具集) -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- WDK 内核模式头文件路径 -->
      <AdditionalIncludeDirectories>
        $(ProjectDir)..\common;
        $(WDKContentRoot)Include\$(WDKVersion)\km;
        $(WDKContentRoot)Include\$(WDKVersion)\shared;
        $(WDKContentRoot)Include\wdf\kmdf\$(KmdfVersionMajor).$(KmdfVersionMinor);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        _AMD64_;
        AMD64;
        KMDF_VERSION_MAJOR=$(KmdfVersionMajor);
        KMDF_VERSION_MINOR=$(KmdfVersionMinor);
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <!-- 内核模式编译器标志 -->
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <RuntimeLibrary />
      <AdditionalOptions>/kernel %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <Link>
      <!-- 内核模式库路径 -->
      <AdditionalLibraryDirectories>
        $(WDKContentRoot)Lib\$(WDKVersion)\km\x64;
        $(WDKContentRoot)Lib\wdf\kmdf\x64\$(KmdfVersionMajor).$(KmdfVersionMinor);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <!-- 内核模式库 -->
      <AdditionalDependencies>
        ntoskrnl.lib;
        hal.lib;
        BufferOverflowFastFailK.lib;
        wdfldr.lib;
        wdfdriverentry.lib;
        wdmsec.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <!-- 内核模式链接器标志 -->
      <SubSystem>Native</SubSystem>
      <Driver>Driver</Driver>
      <EntryPointSymbol>FxDriverEntry</EntryPointSymbol>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <NoEntryPoint>false</NoEntryPoint>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <AdditionalOptions>/DRIVER /MANIFEST:NO /MERGE:_TEXT=.text /MERGE:_PAGE=PAGE %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug 特有设置 -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;DBG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Release 特有设置 -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="brightness.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="driver.h" />
    <ClInclude Include="..\common\public.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
