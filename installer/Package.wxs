<?xml version="1.0" encoding="UTF-8"?>

<!--
  DDCBrightness WiX v5 安装包定义

  安装内容:
  1. DDCBrightness.sys 驱动文件
  2. DDCBrightness.inf 驱动安装配置
  3. DDCBrightness.cat 驱动签名目录
  4. DDCBrightnessService.exe 用户态服务
  5. ddc_test.exe DDC/CI 测试工具
  6. 测试证书

  安装动作:
  1. 复制文件到 Program Files
  2. 安装测试证书到受信任的根证书存储
  3. 使用 pnputil 安装驱动
  4. 通过 CustomAction 追加 UpperFilters
  5. 安装并启动 Windows 服务

  前置要求:
  - 管理员权限
  - 测试签名模式已启用 (bcdedit /set testsigning on)
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="DDCBrightness"
           Manufacturer="DDCBrightness Project"
           Version="$(Version)"
           UpgradeCode="E7A1B2C3-D4E5-F6A7-B8C9-D0E1F2A3B4C5"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="DDC/CI External Monitor Brightness Driver" />

    <Launch Condition="Privileged"
            Message="This program requires administrator privileges." />

    <Launch Condition="VersionNT64"
            Message="DDCBrightness requires a 64-bit Windows system." />

    <Launch Condition="VersionNT &gt;= 603"
            Message="DDCBrightness requires Windows 10 or later." />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Install directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DDCBrightness">
        <Directory Id="DriversFolder" Name="drivers" />
      </Directory>
    </StandardDirectory>

    <!-- Main components -->
    <ComponentGroup Id="MainComponents">

      <Component Id="DriverSysComponent" Directory="DriversFolder" Bitness="always64">
        <File Id="DriverSys"
              Source="$(BuildDir)\DDCBrightness.sys"
              KeyPath="yes" />
      </Component>

      <Component Id="DriverInfComponent" Directory="DriversFolder" Bitness="always64">
        <File Id="DriverInf"
              Source="$(BuildDir)\DDCBrightness.inf"
              KeyPath="yes" />
      </Component>

      <Component Id="DriverCatComponent" Directory="DriversFolder" Bitness="always64">
        <File Id="DriverCat"
              Source="$(BuildDir)\DDCBrightness.cat"
              KeyPath="yes" />
      </Component>

      <Component Id="ServiceExeComponent" Directory="INSTALLFOLDER" Bitness="always64">
        <File Id="ServiceExe"
              Source="$(BuildDir)\DDCBrightnessService.exe"
              KeyPath="yes" />

        <ServiceInstall Id="DDCBrtServiceInstall"
                        Name="DDCBrightnessService"
                        DisplayName="DDC/CI Brightness Control Service"
                        Description="Controls external monitor brightness via DDC/CI"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              RestartServiceDelayInSeconds="30" />
        </ServiceInstall>

        <ServiceControl Id="DDCBrtServiceControl"
                        Name="DDCBrightnessService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="TestToolComponent" Directory="INSTALLFOLDER" Bitness="always64">
        <File Id="TestToolExe"
              Source="$(BuildDir)\ddc_test.exe"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Test certificate -->
    <ComponentGroup Id="CertComponents">
      <Component Id="TestCertComponent" Directory="DriversFolder" Bitness="always64">
        <File Id="TestCert"
              Source="$(CertFile)"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="DDCBrightness" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="CertComponents" />
    </Feature>

    <!-- Custom Actions -->

    <!-- Install test certificate to Root + TrustedPublisher -->
    <SetProperty Id="InstallCertRoot"
                 Before="InstallCertRoot"
                 Sequence="execute"
                 Value="&quot;[System64Folder]certutil.exe&quot; -addstore Root &quot;[DriversFolder]DDCBrightness-test.cer&quot;" />

    <CustomAction Id="InstallCertRoot"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86" />

    <SetProperty Id="InstallCertPublisher"
                 Before="InstallCertPublisher"
                 Sequence="execute"
                 Value="&quot;[System64Folder]certutil.exe&quot; -addstore TrustedPublisher &quot;[DriversFolder]DDCBrightness-test.cer&quot;" />

    <CustomAction Id="InstallCertPublisher"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86" />

    <!-- Install driver via pnputil -->
    <SetProperty Id="InstallDriver"
                 Before="InstallDriver"
                 Sequence="execute"
                 Value="&quot;[System64Folder]pnputil.exe&quot; /add-driver &quot;[DriversFolder]DDCBrightness.inf&quot; /install" />

    <CustomAction Id="InstallDriver"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86" />

    <!-- Add UpperFilters (PowerShell append to REG_MULTI_SZ) -->
    <SetProperty Id="AddUpperFilter"
                 Before="AddUpperFilter"
                 Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -Command &quot;$k='HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e96e-e325-11ce-bfc1-08002be10318}';$v=@();try{$v=[string[]](Get-ItemProperty -Path $k -Name UpperFilters -EA Stop).UpperFilters}catch{};if($v -notcontains 'DDCBrightness'){$v+='DDCBrightness';Set-ItemProperty -Path $k -Name UpperFilters -Value $v -Type MultiString}&quot;" />

    <CustomAction Id="AddUpperFilter"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86" />

    <!-- Remove UpperFilters on uninstall -->
    <SetProperty Id="RemoveUpperFilter"
                 Before="RemoveUpperFilter"
                 Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -Command &quot;$k='HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e96e-e325-11ce-bfc1-08002be10318}';try{$v=[string[]](Get-ItemProperty -Path $k -Name UpperFilters -EA Stop).UpperFilters;$v=$v|?{$_ -ne 'DDCBrightness'};if($v.Count -gt 0){Set-ItemProperty -Path $k -Name UpperFilters -Value $v -Type MultiString}else{Remove-ItemProperty -Path $k -Name UpperFilters -EA SilentlyContinue}}catch{}&quot;" />

    <CustomAction Id="RemoveUpperFilter"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86"
                  Return="ignore" />

    <!-- Uninstall driver -->
    <SetProperty Id="UninstallDriver"
                 Before="UninstallDriver"
                 Sequence="execute"
                 Value="&quot;[System64Folder]pnputil.exe&quot; /delete-driver DDCBrightness.inf /uninstall" />

    <CustomAction Id="UninstallDriver"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryRef="Wix4UtilCA_X86"
                  Return="ignore" />

    <!-- Install sequence -->
    <InstallExecuteSequence>
      <Custom Action="InstallCertRoot" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="InstallCertPublisher" After="InstallCertRoot" Condition="NOT REMOVE" />
      <Custom Action="InstallDriver" After="InstallCertPublisher" Condition="NOT REMOVE" />
      <Custom Action="AddUpperFilter" After="InstallDriver" Condition="NOT REMOVE" />
      <Custom Action="RemoveUpperFilter" Before="RemoveFiles" Condition="REMOVE" />
      <Custom Action="UninstallDriver" After="RemoveUpperFilter" Condition="REMOVE" />
    </InstallExecuteSequence>

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

  </Package>
</Wix>
